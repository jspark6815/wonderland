# ===========================================
# Wonderland Frontend - 환경변수 설정
# ===========================================
# 이 파일을 복사하여 .env 파일을 생성하세요
# cp .env.example .env
#
# ⚠️ VITE_ 접두사가 붙은 변수만 브라우저에서 접근 가능합니다
# 민감한 정보는 절대 프론트엔드 환경변수에 넣지 마세요!

# -------------------------------------------
# API 서버 URL
# -------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1

# -------------------------------------------
# 네이버 지도 API (Naver Cloud Platform)
# -------------------------------------------
# 발급: https://console.ncloud.com → Maps → Application
# 용도: 지도 표시
VITE_NAVER_MAP_KEY_ID=your_naver_map_key_id
# Client ID (선택사항 - Key ID 또는 Client ID 중 하나 사용)
# VITE_NAVER_MAP_CLIENT_ID=your_naver_map_client_id

# -------------------------------------------
# AI 기능 설정
# -------------------------------------------
# AI 응답 스트리밍 활성화 (true | false)
# 스트리밍 활성화 시 실시간으로 AI 응답 표시
VITE_AI_INTERPRET_STREAM=false
