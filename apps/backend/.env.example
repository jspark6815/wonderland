# ===========================================
# Wonderland Backend - 환경변수 설정
# ===========================================
# 이 파일을 복사하여 .env 파일을 생성하세요
# cp .env.example .env

# -------------------------------------------
# 실행 환경
# -------------------------------------------
NODE_ENV=development
PORT=3000

# -------------------------------------------
# 데이터베이스 (PostgreSQL + PostGIS)
# -------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=wonderland

# -------------------------------------------
# JWT 인증
# -------------------------------------------
# ⚠️ 프로덕션에서는 반드시 안전한 시크릿으로 변경하세요!
JWT_SECRET=wonderland-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=wonderland-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# 인증 활성화 여부 (개발 시 false로 설정 가능)
AUTH_ENABLED=false

# -------------------------------------------
# AI/LLM 설정
# -------------------------------------------
# AI Provider 선택 (ollama | gemini)
AI_PROVIDER=ollama

# 공통 AI 옵션
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=30000

# --- Ollama (로컬 LLM) ---
LLM_HOST=http://localhost:11434
LLM_MODEL=llama3.2:3b

# --- Gemini (Google AI) ---
# Google AI Studio에서 API 키 발급: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Gemini 전용 옵션 (설정 시 공통 옵션 오버라이드)
# GEMINI_TEMPERATURE=0.7
# GEMINI_MAX_TOKENS=2048
# GEMINI_TIMEOUT=30000

# -------------------------------------------
# AI 캐시 설정 (토큰 절약)
# -------------------------------------------
# 최대 캐시 항목 수
AI_CACHE_MAX_ITEMS=500
# 캐시 TTL (초 단위, 기본 5분)
AI_CACHE_TTL=300

# -------------------------------------------
# 장소 캐시 설정
# -------------------------------------------
# 최대 캐시 항목 수
CACHE_MAX_ITEMS=1000
# 최대 메모리 (바이트, 기본 50MB)
CACHE_MAX_MEMORY=52428800
# 정리 주기 (밀리초, 기본 1분)
CACHE_CLEANUP_INTERVAL=60000

# -------------------------------------------
# 네이버 검색 API (Naver 개발자 센터)
# -------------------------------------------
# 발급: https://developers.naver.com
# 용도: 장소 검색
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# -------------------------------------------
# Rate Limiting (API 보호)
# -------------------------------------------
# 초당 요청 제한
THROTTLE_SHORT_LIMIT=10
# 10초당 요청 제한
THROTTLE_MEDIUM_LIMIT=50
# 분당 요청 제한
THROTTLE_LONG_LIMIT=200

# -------------------------------------------
# CORS 설정
# -------------------------------------------
FRONTEND_URL=http://localhost:5173
# 또는 CORS_ORIGIN으로 직접 지정
# CORS_ORIGIN=http://localhost:5173
