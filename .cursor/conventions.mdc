```

## 조건부 렌더링

### Early return

```typescript
// ✅ Good: Early return
function PlaceCard({ place }: PlaceCardProps) {
  if (!place) {
    return null;
  }

  if (place.closed) {
    return null;
  }

  return (
    <div>
      {/* 정상 렌더링 */}
    </div>
  );
}

// ❌ Bad: 중첩 조건문
function PlaceCard({ place }: PlaceCardProps) {
  return (
    <>
      {place ? (
        <>
          {place.closed ? (
            <div>Closed</div>
          ) : (
            <div>
              {/* 정상 렌더링 */}
            </div>
          )}
        </>
      ) : (
        <div>No place</div>
      )}
    </>
  );
}
```

## 배열 처리

### map에서 key 사용

```typescript
// ✅ Good: 고유한 key
places.map(place => (
  <PlaceCard key={place.id} place={place} />
));

// ❌ Bad: index를 key로
places.map((place, index) => (
  <PlaceCard key={index} place={place} />
));
```

### filter + map 체이닝

```typescript
// ✅ Good
const openPlaces = places
  .filter(place => !place.closed)
  .map(place => ({
    ...place,
    distance: calculateDistance(place.location, userLocation),
  }));

// ✅ Good: 복잡한 경우 reduce
const categorizedPlaces = places.reduce((acc, place) => {
  const category = place.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(place);
  return acc;
}, {} as Record<PlaceCategory, Place[]>);
```

## 객체/배열 조작

### Spread 연산자

```typescript
// ✅ Good
const updatedPlace = { ...place, rating: 4.5 };
const newPlaces = [...places, newPlace];

// ❌ Bad: 직접 수정
place.rating = 4.5;
places.push(newPlace);
```

### 구조 분해 할당

```typescript
// ✅ Good
const { name, rating, category } = place;
const [first, second, ...rest] = places;

// ❌ Bad
const name = place.name;
const rating = place.rating;
```

