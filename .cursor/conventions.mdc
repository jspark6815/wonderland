## 에러 처리

### Frontend

```typescript
// ✅ Good: React Query 에러 처리
const { data, error, isError } = usePlaces(query);

if (isError) {
  return (
    <ErrorMessage
      message={error.message}
      onRetry={() => refetch()}
    />
  );
}

// ✅ Good: try-catch (필요한 경우)
try {
  const result = await someAsyncOperation();
  return result;
} catch (error) {
  if (error instanceof NetworkError) {
    toast.error('네트워크 오류가 발생했습니다.');
  }
  throw error; // 상위로 전파
}

// ❌ Bad: 에러 무시
try {
  await someAsyncOperation();
} catch (error) {
  // 빈 catch 블록
}
```

### Backend

```typescript
// ✅ Good: 명확한 에러와 상태 코드
@Get(':id')
async getPlace(@Param('id') id: string): Promise<Place> {
  const place = await this.placesService.findOne(id);

  if (!place) {
    throw new NotFoundException(
      `Place with ID ${id} not found`,
      'PLACE_NOT_FOUND'
    );
  }

  return place;
}

// ✅ Good: Custom Exception
export class PlaceNotFoundException extends NotFoundException {
  constructor(id: string) {
    super(
      `Place with ID ${id} not found`,
      'PLACE_NOT_FOUND'
    );
  }
}
```

## 비동기 처리

### async/await 우선

```typescript
// ✅ Good: async/await
async function fetchPlaces(): Promise<Place[]> {
  const response = await apiClient.get('/places');
  return response.data;
}

// ❌ Bad: Promise chain
function fetchPlaces(): Promise<Place[]> {
  return apiClient.get('/places')
    .then(response => response.data);
}
```

### Promise.all 활용

```typescript
// ✅ Good: 병렬 실행
const [places, trending] = await Promise.all([
  placesApi.searchPlaces(query),
  searchApi.getTrending(),
]);

// ❌ Bad: 순차 실행
const places = await placesApi.searchPlaces(query);
const trending = await searchApi.getTrending();
```

